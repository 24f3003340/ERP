{
  "name": "local-erp-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Local ERP desktop shell",
  "main": "main.js",
  "author": "Local ERP",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.localerp.app",
    "productName": "Local ERP",
    "directories": { "output": "release" },
    "files": ["main.js", "preload.js", "package.json"],
    "extraResources": [{ "from": "../build/dist/erp-server", "to": "server" }],
    "win": { "target": "nsis" },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
